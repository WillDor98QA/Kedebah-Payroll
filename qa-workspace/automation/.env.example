# Copy to .env and fill in. .env is gitignored; never put real credentials in this template.

# Base URL of the app under test (staging / sandbox / local)
BASE_URL=https://staging.example.invalid

# API base (only if different from BASE_URL)
# API_BASE_URL=https://staging.example.invalid/api

# Role credentials (REQ-AUTH-007/008/011, REQ-SEC-*). Admin minimum; add Manager/Staff to unblock
# the role/permission/self-service cases.
ADMIN_IDENTIFIER=
ADMIN_PASSWORD=
# MANAGER_IDENTIFIER=
# MANAGER_PASSWORD=
# STAFF_IDENTIFIER=
# STAFF_PASSWORD=

# PIM self-service portal (optional, open question #5)
# PIM_BASE_URL=

# Test execution toggles
HEADLESS=true
WORKERS=4
